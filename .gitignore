node_modules/
*.log
.DS_Store

# Assembled app bundle. Generated by tools/build-dist.mjs from an explicit
# allowlist -- never hand-edited, and never committed.
dist/

# Signing keys must never be committed. The canonical keystore lives outside
# the repo (~/.config/sudoku-twa) and reaches CI only as a base64 secret.
*.keystore
*.jks
*.p12
*.pfx
keystore.properties

# Gradle output (CI writes these too).
android/.gradle/
android/app/build/
android/build/
android/local.properties

# Regenerated by `npx cap sync` on every run: the copied web bundle and the
# Cordova plugin stub that capacitor.settings.gradle pulls in. Committing them
# would produce a diff on every single web change for files nobody reads.
# Both CI and local builds run `cap sync` before gradle, so they always exist
# when the build needs them.
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/
